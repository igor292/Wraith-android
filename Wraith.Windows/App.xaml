<Application x:Class="Wraith.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Color x:Key="BgColor">#090B11</Color><Color x:Key="PanelColor">#141923</Color><Color x:Key="CardColor">#1B2230</Color>
    <Color x:Key="TextColor">#F4F6FB</Color><Color x:Key="MutedColor">#929AAC</Color><Color x:Key="MintColor">#74E4D0</Color><Color x:Key="LineColor">#283141</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}"/><SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/><SolidColorBrush x:Key="Mint" Color="{StaticResource MintColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="160"/></Style>
  </Application.Resources>
</Application>
