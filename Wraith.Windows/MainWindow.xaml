<Window x:Class="Wraith.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wraith" Width="1180" Height="820" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Panel}" Padding="18"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28"><TextBlock Text="WRAITH" FontSize="22" FontWeight="Bold"/><TextBlock Text="Secure connection" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="4,18,4,4"><TextBlock x:Name="VersionLabel" Text="Wraith · Windows" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="sing-box 1.14.1 core" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
   <StackPanel x:Name="Navigation"/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="0"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Главная" FontSize="22" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock x:Name="NoticeText" Text="" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0" MaxWidth="420" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CoreState" Text="Отключено" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="＋ Добавить" Background="{StaticResource Mint}" Foreground="#091110" Click="Add_Click"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24"><StackPanel x:Name="PageContent" MaxWidth="1100" HorizontalAlignment="Stretch"/></ScrollViewer>
  </Grid>
 </Grid>
</Window>
